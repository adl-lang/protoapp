# node, pnpm and deno are also provided by the nix dev shell (see nix/flake.nix).
# Keep the versions here in step with the ones nixpkgs provides there, so that
# both entry points build the project with the same toolchain.
node = "24.21.0"
pnpm = "10.34.5"
deno = "2.9.7"
adlc = "1.4.0"

[plugins]
adlc = "https://raw.githubusercontent.com/adl-lang/proto-toml-plugins/main/adlc/plugin.toml"
