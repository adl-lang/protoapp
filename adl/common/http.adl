module common.http {

/// Request types

/// An API is a struct whose fields are HttpReq values. The HTTP path of each
/// endpoint is derived from its field name, as "/" ++ the field name, and must
/// be derived identically by every backend that consumes an API: the rust
/// server, the typescript client and the api workbench.
struct HttpReq<I,O> {

  // Requests are post by default. If a given request:
  //     - is side-effect free
  //     - has a body I is small enough to fit encoded in the URI
  // one can set the method to "get", eg to allow CDN caching etc 
  HttpMethod method = "post";

  HttpSecurity security;
  TypeToken<I> reqType = null;
  TypeToken<O> respType = null;
};

union HttpMethod {
  Void get;
  Void post;
};


union HttpSecurity {
  // The endpoint is publically accessible
  Void public;

  // A token is required to access the endpoint
  Void token;

  // A token containing the specified role is required
  // for access
  String tokenWithRole;
};

/// Empty Struct (Used mostly for Void RPC responses)
struct Unit {};

};

